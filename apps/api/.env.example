# Supabase Postgres, transaction pooler (port 6543)
DATABASE_URL=

# Supabase Storage S3-compatible endpoint: https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Allowed web origins, comma-separated (example: https://your-web.netlify.app)
CORS_ORIGIN=

# Optional: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
